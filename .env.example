# Backend server environment (set these in your hosting provider, not in Git)
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me_never_commit_real_secrets
FRONTEND_ORIGIN=https://rajtivari.github.io
ALLOW_LIVE_PAYMENTS=false

# GitHub repository Actions variable for the frontend build:
# VITE_API_BASE_URL=https://your-deployed-docswift-api.example.com

# Optional NexoraPay sandbox merchant integration (server only; never use a live key here)
NEXORAPAY_BASE_URL=https://nexorapay-sandbox.onrender.com
NEXORAPAY_MERCHANT_API_KEY=np_test_replace_with_sandbox_merchant_key
